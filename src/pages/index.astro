---
import ContributionGraph from '../components/ContributionGraph.astro';
import { AUTHOR, SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import BaseLayout from '../layouts/BaseLayout.astro';
import { fetchContributions } from '../utils/contributions';

const days = await fetchContributions(AUTHOR);

const skills = [
	['Mobile', 'Flutter · React Native · Dart'],
	['Frontend', 'React · TypeScript · JavaScript'],
	['Backend', 'Java · Spring Boot · REST API · Spring Security/JWT · MyBatis · JPA/QueryDSL'],
	['Database', 'MSSQL · Oracle · MySQL · SQLite'],
	['Infra', 'AWS(S3/CloudFront/RDS) · Docker · GitHub Actions · FCM'],
];
---

<BaseLayout title={SITE_TITLE} description={SITE_DESCRIPTION}>
	<h1 class="sr-only">{SITE_TITLE}</h1>

	<section>
		<h2>GitHub 활동</h2>
		<ContributionGraph days={days} />
	</section>

	<section>
		<h2>기술 스택</h2>
		<dl class="skills">
			{
				skills.map(([area, list]) => (
					<>
						<dt>{area}</dt>
						<dd>{list}</dd>
					</>
				))
			}
		</dl>
	</section>
</BaseLayout>

<style>
	h2 {
		margin-top: 0;
	}
	section + section {
		margin-top: 3rem;
	}
	.skills {
		display: grid;
		grid-template-columns: max-content 1fr;
		gap: 0.5rem 1.25rem;
		margin: 0;
	}
	.skills dt {
		font-weight: 600;
	}
	.skills dd {
		margin: 0;
		color: var(--text-muted);
	}
	@media (max-width: 560px) {
		.skills {
			grid-template-columns: 1fr;
			gap: 0 0;
		}
		.skills dd {
			margin-bottom: 0.75rem;
		}
	}
</style>
