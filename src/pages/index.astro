---
import { getCollection } from 'astro:content';
import PostList from '../components/PostList.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getPosts } from '../utils/posts';

const posts = (await getPosts()).slice(0, 5);
const projects = (await getCollection('projects', ({ data }) => data.featured)).sort(
	(a, b) => a.data.order - b.data.order,
);
---

<BaseLayout title={SITE_TITLE} description={SITE_DESCRIPTION}>
	<section class="intro">
		<h1>안녕하세요, jisuuo입니다.</h1>
		<p class="muted">만들면서 배운 것들을 기록합니다. 이 소개 문구는 <code>src/pages/index.astro</code>에서 수정하세요.</p>
	</section>

	<section>
		<h2>최근 글</h2>
		<PostList posts={posts} />
		<p><a href="/blog/">전체 글 보기 →</a></p>
	</section>

	{
		projects.length > 0 && (
			<section>
				<h2>대표 프로젝트</h2>
				<div class="grid">
					{projects.map((project) => (
						<ProjectCard project={project} />
					))}
				</div>
				<p>
					<a href="/projects/">전체 프로젝트 보기 →</a>
				</p>
			</section>
		)
	}
</BaseLayout>

<style>
	.intro {
		margin-bottom: 3rem;
	}
	section + section {
		margin-top: 3rem;
	}
</style>
