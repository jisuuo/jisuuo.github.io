---
import { Image } from 'astro:assets';
import FormattedDate from '../components/FormattedDate.astro';
import SeriesBox from '../components/SeriesBox.astro';
import { getPosts, groupBy, slugify, sortSeries, type Post } from '../utils/posts';
import BaseLayout from './BaseLayout.astro';

interface Props {
	post: Post;
}

const { post } = Astro.props;
const { title, description, pubDate, updatedDate, heroImage, tags, series } = post.data;

// 시리즈 글이면 시리즈 안의 이전/다음 글로 연결한다.
let prev: Post | undefined;
let next: Post | undefined;
if (series) {
	const posts = sortSeries(groupBy(await getPosts(), 'series').get(series) ?? []);
	const index = posts.findIndex((p) => p.id === post.id);
	prev = posts[index - 1];
	next = posts[index + 1];
}
---

<BaseLayout title={title} description={description} image={heroImage}>
	<article data-pagefind-body>
		<header class="post-header">
			<h1>{title}</h1>
			<div class="meta">
				<FormattedDate date={pubDate} />
				{
					updatedDate && (
						<span>
							(수정: <FormattedDate date={updatedDate} />)
						</span>
					)
				}
			</div>
			{
				tags.length > 0 && (
					<div class="tags">
						{tags.map((tag) => (
							<a href={`/tags/${slugify(tag)}/`}>#{tag}</a>
						))}
					</div>
				)
			}
		</header>
		{heroImage && <Image class="hero" width={1020} height={510} src={heroImage} alt="" />}
		{series && <SeriesBox post={post} />}
		<div class="prose">
			<slot />
		</div>
	</article>
	{
		(prev || next) && (
			<nav class="series-nav" aria-label="시리즈 이전/다음 글">
				{prev ? (
					<a href={`/blog/${prev.id}/`}>
						<small>← 이전 글</small>
						{prev.data.title}
					</a>
				) : (
					<span />
				)}
				{next && (
					<a class="next" href={`/blog/${next.id}/`}>
						<small>다음 글 →</small>
						{next.data.title}
					</a>
				)}
			</nav>
		)
	}
</BaseLayout>

<style>
	.post-header {
		margin-bottom: 2rem;
	}
	h1 {
		margin: 0 0 0.5rem;
		font-size: 2rem;
		line-height: 1.3;
	}
	.meta {
		display: flex;
		gap: 0.5rem;
		color: var(--text-muted);
		font-size: 0.9rem;
	}
	.tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
		margin-top: 0.5rem;
		font-size: 0.9rem;
	}
	.hero {
		width: 100%;
		height: auto;
		margin-bottom: 2rem;
		border-radius: 10px;
	}
	.series-nav {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 1rem;
		margin-top: 3rem;
	}
	.series-nav a {
		display: flex;
		flex-direction: column;
		padding: 1rem;
		border: 1px solid var(--border);
		border-radius: 8px;
		color: var(--text);
		text-decoration: none;
	}
	.series-nav a:hover {
		border-color: var(--accent);
	}
	.series-nav small {
		color: var(--text-muted);
	}
	.series-nav .next {
		grid-column: 2;
		text-align: right;
	}
</style>
