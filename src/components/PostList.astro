---
import type { Post } from '../utils/posts';
import { slugify } from '../utils/posts';
import FormattedDate from './FormattedDate.astro';
import { readingMinutes } from '../utils/topic-tree';

interface Props {
	posts: Post[];
}

const { posts } = Astro.props;
---

<ul class="post-list">
	{
		posts.map((post) => (
			<li>
				<a class="title" href={`/blog/${post.id}/`}>
					{post.data.draft && <span class="draft">DRAFT</span>}
					{post.data.title}
				</a>
				<p class="description">{post.data.description}</p>
				<div class="meta">
					<FormattedDate date={post.data.pubDate} />
					{post.data.tags.map((tag) => (
						<a class="tag" href={`/tags/${slugify(tag)}/`}>
							#{tag}
						</a>
					))}
					<span class="reading">{readingMinutes(post.body ?? '')}분</span>
				</div>
			</li>
		))
	}
</ul>

<style>
	.post-list {
		margin: 0;
		padding: 0;
		list-style: none;
	}
	li {
		padding: 1rem 0;
		border-bottom: 1px solid var(--border);
	}
	.title {
		color: var(--text);
		font-size: 1.05rem;
		font-weight: 600;
		line-height: 1.4;
		text-decoration: none;
	}
	.title:hover {
		color: var(--accent);
	}
	.description {
		display: -webkit-box;
		margin: 0.35rem 0;
		overflow: hidden;
		color: var(--text-muted);
		font-size: 0.92rem;
		line-height: 1.6;
		-webkit-box-orient: vertical;
		-webkit-line-clamp: 2;
	}
	.meta {
		display: flex;
		flex-wrap: wrap;
		gap: 0.25rem 0.75rem;
		color: var(--text-muted);
		font-family: var(--font-mono);
		font-size: 0.78rem;
	}
	.tag {
		color: var(--accent);
		text-decoration: none;
	}
	.reading {
		margin-left: auto;
	}
	.draft {
		margin-right: 0.5rem;
		padding: 0.1rem 0.4rem;
		border-radius: 4px;
		background: var(--accent);
		color: white;
		font-size: 0.7rem;
		vertical-align: middle;
	}
</style>
