---
import type { Post } from '../utils/posts';
import { slugify } from '../utils/posts';
import FormattedDate from './FormattedDate.astro';

interface Props {
	posts: Post[];
}

const { posts } = Astro.props;
---

<ul class="post-list">
	{
		posts.map((post) => (
			<li>
				<a class="title" href={`/blog/${post.id}/`}>
					{post.data.draft && <span class="draft">DRAFT</span>}
					{post.data.title}
				</a>
				<p class="description">{post.data.description}</p>
				<div class="meta">
					<FormattedDate date={post.data.pubDate} />
					{post.data.tags.map((tag) => (
						<a class="tag" href={`/tags/${slugify(tag)}/`}>
							#{tag}
						</a>
					))}
				</div>
			</li>
		))
	}
</ul>

<style>
	.post-list {
		margin: 0;
		padding: 0;
		list-style: none;
	}
	li {
		padding: 1.25rem 0;
		border-bottom: 1px solid var(--border);
	}
	.title {
		color: var(--text);
		font-size: 1.15rem;
		font-weight: 600;
		text-decoration: none;
	}
	.title:hover {
		color: var(--accent);
	}
	.description {
		margin: 0.35rem 0;
		color: var(--text-muted);
	}
	.meta {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
		color: var(--text-muted);
		font-size: 0.85rem;
	}
	.draft {
		margin-right: 0.5rem;
		padding: 0.1rem 0.4rem;
		border-radius: 4px;
		background: var(--accent);
		color: white;
		font-size: 0.7rem;
		vertical-align: middle;
	}
</style>
