---
import { getPosts, groupBy, slugify, sortSeries, type Post } from '../utils/posts';

interface Props {
	post: Post;
}

const { post } = Astro.props;
const name = post.data.series!;
const posts = sortSeries(groupBy(await getPosts(), 'series').get(name) ?? []);
const index = posts.findIndex((p) => p.id === post.id);
---

<nav class="series" aria-label="시리즈">
	<a class="name" href={`/series/${slugify(name)}/`}>{name}</a>
	<span class="count">({index + 1}/{posts.length})</span>
	<ol>
		{
			posts.map((p) => (
				<li class:list={{ current: p.id === post.id }}>
					{p.id === post.id ? p.data.title : <a href={`/blog/${p.id}/`}>{p.data.title}</a>}
				</li>
			))
		}
	</ol>
</nav>

<style>
	.series {
		margin: 0 0 2rem;
		padding: 1rem 1.25rem;
		border-left: 4px solid var(--accent);
		border-radius: 6px;
		background: var(--bg-soft);
	}
	.name {
		color: var(--text);
		font-weight: 700;
		text-decoration: none;
	}
	.count {
		margin-left: 0.25rem;
		color: var(--text-muted);
	}
	ol {
		margin: 0.5rem 0 0;
		padding-left: 1.25rem;
		font-size: 0.95rem;
	}
	.current {
		font-weight: 600;
	}
</style>
